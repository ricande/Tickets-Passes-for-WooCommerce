msgid "Not Valid or Already Used (202)"
msgstr "Inte giltig eller redan använd (202)"

#: inc/api/setting-pages/api-page-content.php:192
msgid "Color shown when a scan happens outside its valid time window, on cooldown after a previous scan, or after it has already reached its maximum uses."
msgstr "Färg som visas när en skanning sker utanför giltig tid, i väntetid efter en tidigare skanning, eller när max antal användningar redan nåtts."

#: inc/api/setting-pages/api-page-content.php:202
msgid "Invalid Request (406)"
msgstr "Ogiltig begäran (406)"

